{
  "name": "snake-language",
  "displayName": "Snake Language",
  "description": "Language support for the Snake programming language (.snk)",
  "version": "1.0.0",
  "publisher": "snake-lang",
  "engines": { "vscode": "^1.84.0" },
  "categories": ["Programming Languages"],
  "icon": "icons/snake-icon.png",
  "contributes": {
    "languages": [
      {
        "id": "snake",
        "aliases": ["Snake", "snake"],
        "extensions": [".snk"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/snake-icon.png",
          "dark": "./icons/snake-icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "snake",
        "scopeName": "source.snake",
        "path": "./syntaxes/snake.tmLanguage.json"
      }
    ]
  }
}
